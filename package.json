{
  "name": "watashi-no-sekai-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cpu": "node scripts/cpu-smoke.mjs",
    "smoke:cpu-logs": "node scripts/cpu-log-smoke.mjs",
    "test:cpu-choice": "node --experimental-strip-types scripts/cpu-choice.mjs",
    "jev:direct": "node --experimental-strip-types scripts/jev-direct.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "wrangler": "4.140.0"
  }
}
